#!/bin/sh
set -eu

message_file=$1
header=$(sed -n '1p' "$message_file")

pattern='^(feat|fix|docs|test|build|ci|refactor|perf|style|chore|revert)(\([[:alnum:]][[:alnum:]./_-]*\))?!?: .+$'

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
    printf '%s\n' \
        "Invalid commit message." \
        "Expected: type(scope): description" \
        "Example: feat(protobuf): implement varint decoding" >&2
    exit 1
fi